[Unit]
Description=SysAdmin Agent Dashboard (Streamlit)
After=network.target

[Service]
Type=simple
User=dshannon
Group=dshannon
WorkingDirectory=/data/ai-workspace/sysadmin-agent
ExecStart=/usr/bin/python3 -m streamlit run app.py --server.port 8501 --server.address 127.0.0.1 --server.headless true --browser.gatherUsageStats false --server.baseUrlPath sysadmin --server.enableXsrfProtection false --server.enableCORS false
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/data/ai-workspace/sysadmin-agent/logs

# Environment
Environment="PYTHONPATH=/data/ai-workspace/sysadmin-agent"

[Install]
WantedBy=multi-user.target
